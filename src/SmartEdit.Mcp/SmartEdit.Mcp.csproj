<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Publish-профиль: один exe поверх установленного рантайма (framework-dependent), R2R —
         мгновенный старт без распаковки и JIT-прогрева (паттерн SupportOnlineChat).
         Полный Native AOT — в roadmap: нужен MSVC-линкер (VS C++ Build Tools); сериализация
         уже переведена на source-gen, других блокеров нет. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <!-- gate/v1 (#18): tree-sitter — синтаксический гейт save. Пакет тащит 28 грамматик × 9 платформ
         (~590МБ в publish); PruneTreeSitterGrammars ниже режет до win-x64 + наш набор (~11МБ). -->
    <PackageReference Include="TreeSitter.DotNet" Version="1.3.0" />
  </ItemGroup>
  <!-- #22/v0.12.1: пакет несёт все RID; вырезаем чужие нативы ПОСЛЕ publish —
       whitelist выбирается по целевой ОС сборки (win-сборка режет .so/.dylib; linux-сборка — наоборот) -->
  <Target Name="PruneTreeSitterGrammars" AfterTargets="Publish">
    <PropertyGroup>
      <!-- linux/osx RID-сборка: сохраняем .so/.dylib своего RID, режем win-dll -->
      <TsIsUnix Condition="'$(RuntimeIdentifier)' != '' AND !$(RuntimeIdentifier.StartsWith('win'))">true</TsIsUnix>
    </PropertyGroup>
    <ItemGroup Condition="'$(TsIsUnix)' != 'true'">
      <TsNative Include="$(PublishDir)tree-sitter-*.dll;$(PublishDir)runtimes\**\*.dll;$(PublishDir)runtimes\**\*.so;$(PublishDir)runtimes\**\*.dylib" />
      <TsNative Remove="$(PublishDir)tree-sitter.dll" />
      <TsNative Remove="$(PublishDir)tree-sitter-c-sharp.dll" />
      <TsNative Remove="$(PublishDir)tree-sitter-javascript.dll" />
      <TsNative Remove="$(PublishDir)tree-sitter-typescript.dll" />
      <TsNative Remove="$(PublishDir)tree-sitter-tsx.dll" />
      <TsNative Remove="$(PublishDir)tree-sitter-python.dll" />
      <TsNative Remove="$(PublishDir)tree-sitter-bash.dll" />
    </ItemGroup>
    <ItemGroup Condition="'$(TsIsUnix)' == 'true'">
      <!-- unix-сборка: вырезаем win-варианты и ЧУЖИЕ unix-RID; свои .so/.dylib лежат плоско рядом с exe -->
      <TsNative Include="$(PublishDir)*.dll;$(PublishDir)runtimes\**\*" />
    </ItemGroup>
    <Delete Files="@(TsNative)" />
    <RemoveDir Directories="$(PublishDir)runtimes" Condition="Exists('$(PublishDir)runtimes')" />
  </Target>
</Project>
